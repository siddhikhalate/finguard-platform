# FinGuard - .gitignore
# Compiled class files
target/
*.class

# Log files
*.log
logs/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven
.mvn/wrapper/maven-wrapper.jar

# IDE specific files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node / React Frontend
node_modules/
dist/
build/
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker local data directories
docker-data/
postgres-data/
kafka-data/
redis-data/

# Secrets and local environments
*.env
!.env.example
*.pem
*.key
*.jks

# Local portable tools
maven/
