# ==============================================================================
# FinGuard Enterprise Platform - Environment Configuration Template
# Copy this file to .env and adjust variables for your local or production environment.
# NEVER commit real credentials, production API keys, or private secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard_secret
POSTGRES_DB=finguard_master

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT & Internal Gateway Security
# Ensure this is a 256-bit (32-character or base64) cryptographically secure secret in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
INTERNAL_GATEWAY_KEY=finguard-internal-secret-gateway-key-change-in-prod

# Spring AI / LLM Configuration
# Supports OpenAI, Groq, Ollama, etc. FinGuard falls back to deterministic rules if empty/offline.
SPRING_AI_OPENAI_API_KEY=your_openai_or_groq_api_key_here
SPRING_AI_OPENAI_MODEL=gpt-4o-mini
SPRING_AI_BASE_URL=https://api.openai.com

# Service Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
TRANSACTION_SERVICE_PORT=8082
FRAUD_DETECTION_SERVICE_PORT=8083
INCIDENT_SERVICE_PORT=8084
AI_EXPLANATION_SERVICE_PORT=8085
